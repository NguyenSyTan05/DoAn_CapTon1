# ai-service đọc biến môi trường của tiến trình (không tự nạp file .env).
# Đặt trong shell trước khi chạy uvicorn, ví dụ PowerShell:  $env:AI_AUTH_MODE="enforce"

# Xác thực REST (core/auth.py)
# enforce (mặc định): bắt buộc JWT Flask + quyền vào phòng; off: bỏ qua mọi kiểm tra (chỉ dev/test)
AI_AUTH_MODE=enforce
# PHẢI trùng SECRET_KEY của backend Flask, tối thiểu 32 ký tự
SECRET_KEY=change-me-to-the-same-value-as-flask-min-32-chars
# Địa chỉ Flask để hỏi quyền vào phòng: GET {FLASK_API_URL}/auth/sessions/<id>/access
FLASK_API_URL=http://127.0.0.1:5000

# CORS: danh sách origin của frontend, phân tách bằng dấu phẩy
# (mở frontend từ máy khác trong LAN thì thêm http://<ip>:4000)
AI_ALLOWED_ORIGINS=http://localhost:4000,http://127.0.0.1:4000

# STT (Speech-to-Text): ưu tiên GPU CUDA nếu có; để trống WHISPER_MODEL_PATH để tự dùng Large-v3-Turbo
WHISPER_DEVICE=auto
WHISPER_MODEL_PATH=trained_models/stt/whisper-large-v3-turbo-ct2
