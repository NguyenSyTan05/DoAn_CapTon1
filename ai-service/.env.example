# Sao chép file này thành ai-service/.env. ai-service tự động nạp file .env khi khởi động.

# --- Xác thực JWT & Phân quyền phiên học (core/auth.py) ---
# enforce (mặc định): bắt buộc JWT Flask + quyền vào phòng; off: chỉ dùng khi dev cục bộ
AI_AUTH_MODE=enforce
# BẮT BUỘC trùng khớp hoàn toàn với SECRET_KEY trong backend/.env (>= 32 ký tự)
SECRET_KEY=doi-thanh-chuoi-bi-mat-trung-voi-backend-it-nhat-32-ky-tu
FLASK_API_URL=http://127.0.0.1:5000

# --- CORS & Mạng LAN (QR Code điện thoại cùng Wi-Fi) ---
AI_ALLOWED_ORIGINS=http://localhost:4000,http://127.0.0.1:4000
AI_ALLOW_LAN_ORIGINS=1

# --- Lưu trữ dữ liệu AI & RAG Vector DB ---
# memory (mặc định: RAM + JSON cục bộ, an toàn cho DB dùng chung) | postgres (ghi xuyên suốt PostgreSQL)
AI_STORAGE_BACKEND=memory
# Chỉ bắt buộc khi đặt AI_STORAGE_BACKEND=postgres:
# DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST/DBNAME?sslmode=require
QDRANT_URL=http://127.0.0.1:6333
RAG_SIMILARITY_THRESHOLD=0.45

# --- 6 Lớp Bảo vệ AI, Ngân sách Token & Hàng đợi DynamicBatcher ---
AI_KILL_SWITCH=false
AI_SESSION_TOKEN_BUDGET=50000
AI_BATCHER_MAX_QUEUE=32
AI_LATENCY_BUDGET_MS=15000

# --- Mô hình STT Faster-Whisper CTranslate2 (ưu tiên GPU CUDA nếu có) ---
WHISPER_DEVICE=auto
WHISPER_MODEL_PATH=trained_models/stt/whisper-large-v3-turbo-ct2
WHISPER_VI_MODEL_PATH=trained_models/stt/whisper-large-v3-turbo-ct2
WHISPER_EN_MODEL_PATH=

# --- (Tuỳ chọn) LLM tương thích OpenAI / Ollama cho Tóm tắt bài giảng nâng cao ---
# Để trống sẽ tự động dùng Hybrid Semantic Extractive Summarizer (MiniLM + NLLB) không tốn thêm VRAM
# SUMMARY_LLM_BASE_URL=http://127.0.0.1:11434/v1
# SUMMARY_LLM_MODEL=qwen2.5:7b
# SUMMARY_LLM_API_KEY=ollama
