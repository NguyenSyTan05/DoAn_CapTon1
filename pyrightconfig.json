{
  "venvPath": "..",
  "venv": ".venv",
  "typeCheckingMode": "off",
  "extraPaths": [
    "backend",
    "ai-service",
    "../.venv/Lib/site-packages",
    "backend/.venv/Lib/site-packages",
    "ai-service/.venv/Lib/site-packages"
  ],
  "pythonVersion": "3.11",
  "reportMissingImports": "none",
  "reportMissingModuleSource": "none"
}
