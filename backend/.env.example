# Sao chép file này thành backend/.env rồi điền giá trị thật. KHÔNG commit file .env lên Git.

# --- Cơ sở dữ liệu PostgreSQL (Neon) ---
# Dùng driver ĐỒNG BỘ: postgresql:// hoặc postgresql+psycopg2:// (KHÔNG dùng postgresql+asyncpg://)
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST/DBNAME?sslmode=require

# --- Khóa bí mật chung (ký JWT Flask & đối chiếu sang ai-service) — BẮT BUỘC >= 32 ký tự ---
# Tạo nhanh: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=doi-thanh-chuoi-bi-mat-ngau-nhien-rat-dai-it-nhat-32-ky-tu

# --- Thời hạn JWT theo vai trò (đơn vị: giờ) ---
ADMIN_TOKEN_HOURS=1
LECTURER_TOKEN_HOURS=8
STUDENT_TOKEN_HOURS=4

# --- CORS & Mạng LAN (QR Code trên điện thoại cùng Wi-Fi) ---
FRONTEND_ORIGIN=http://localhost:4000
ALLOW_LAN_ORIGINS=1

# --- SMTP gửi mã OTP (Đăng ký tài khoản Sinh viên & Quên mật khẩu 3 vai trò) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# --- (Tuỳ chọn) Khóa API kiểm tra định dạng/tồn tại email nâng cao ---
EMAIL_VALIDATION_API_KEY=
