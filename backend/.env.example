# Sao chép file này thành backend/.env rồi điền giá trị thật. KHÔNG commit file .env.

# --- Cơ sở dữ liệu PostgreSQL (Neon) ---
# Dùng driver ĐỒNG BỘ: postgresql://  hoặc  postgresql+psycopg2://   (KHÔNG dùng postgresql+asyncpg://)
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST/DBNAME?sslmode=require

# --- Khóa bí mật (ký JWT và session Flask) — BẮT BUỘC, tối thiểu 32 ký tự, ngẫu nhiên ---
# Thiếu hoặc quá ngắn thì backend sẽ không khởi động.
# Tạo nhanh: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=doi-thanh-chuoi-bi-mat-ngau-nhien-rat-dai-it-nhat-32-ky-tu

# --- Thời hạn JWT theo vai trò (đơn vị: giờ, số dương, có thể lẻ như 0.5) ---
# Mọi vai trò dùng chung SECRET_KEY ở trên; ai-service xác minh token bằng cùng khóa này.
ADMIN_TOKEN_HOURS=1
LECTURER_TOKEN_HOURS=8
STUDENT_TOKEN_HOURS=4

# --- Địa chỉ frontend được phép gọi API (CORS). Frontend chạy ở cổng 4000 ---
FRONTEND_ORIGIN=http://localhost:4000

# --- Gửi email xác thực khi sinh viên đăng ký (xem SMTP_SETUP.md) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# --- Dịch vụ kiểm tra email có tồn tại không (xem EMAIL_VALIDATION.md) ---
EMAIL_VALIDATION_API_KEY=
